@model Musteri
@{
    ViewData["Title"] = "Müşteri Düzenle";
    ViewData["PageTitle"] = "Müşteri Düzenle";
    ViewData["Subtitle"] = "Kayıtlı müşteri bilgilerini güncelle.";
}

<div class="card">
    <div class="card-body p-4 p-lg-5">
    <span class="admin-chip">Kayıt Güncelle</span>
    <h3 class="mt-3">Müşteri Düzenle</h3>
    <p class="text-secondary mb-4">İletişim ve üyelik için temel bilgileri güncel tut.</p>

    <form asp-action="Edit" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation full"></div>

        <div class="field">
            <label asp-for="AdSoyad"></label>
            <input asp-for="AdSoyad" class="input" />
            <span asp-validation-for="AdSoyad" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Telefon"></label>
            <input asp-for="Telefon" class="input" />
            <span asp-validation-for="Telefon" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="input" />
            <span asp-validation-for="Email" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Sifre">Üye Şifresi</label>
            <input asp-for="Sifre" class="input" />
            <span asp-validation-for="Sifre" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="KayitTarihi">Kayıt Tarihi</label>
            <input asp-for="KayitTarihi" class="input" type="datetime-local" />
            <span asp-validation-for="KayitTarihi" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="SonGirisTarihi">Son Giriş Tarihi</label>
            <input asp-for="SonGirisTarihi" class="input" type="datetime-local" />
            <span asp-validation-for="SonGirisTarihi" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="SifreSifirlamaKodu">Şifre Sıfırlama Kodu</label>
            <input asp-for="SifreSifirlamaKodu" class="input" />
            <span asp-validation-for="SifreSifirlamaKodu" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="SifreSifirlamaKodSonTarih">Kod Bitiş Tarihi</label>
            <input asp-for="SifreSifirlamaKodSonTarih" class="input" type="datetime-local" />
            <span asp-validation-for="SifreSifirlamaKodSonTarih" class="validation"></span>
        </div>

        <div class="field full">
            <label class="form-check d-flex align-items-center gap-2">
                <input asp-for="UyeHesabiVar" class="form-check-input mt-0" />
                <span>Üye hesabı aktif</span>
            </label>
            <span asp-validation-for="UyeHesabiVar" class="validation"></span>
        </div>

        <div class="link-row full">
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Index" class="btn btn-light">Geri Dön</a>
        </div>
    </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
