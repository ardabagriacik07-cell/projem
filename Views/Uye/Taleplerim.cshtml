@model List<ServisKaydi>
@{
    ViewData["Title"] = "Taleplerim";

    string DurumSinif(string durum)
    {
        return durum switch
        {
            "Bekliyor" => "waiting",
            "Islemde" => "work",
            "Fiyat Onayi Bekliyor" => "work",
            "Tamamlandi" => "done",
            "Teslim Edildi" => "delivery",
            "Fiyat Reddedildi" => "rejected",
            _ => "waiting"
        };
    }
}

<div class="card member-card">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <span class="member-section-badge">Tüm Kayıtlar</span>
                <h3 class="mb-0 mt-2">Servis Taleplerim</h3>
            </div>
            <a class="btn btn-info fw-semibold" asp-action="YeniTalep">Yeni Talep</a>
        </div>

        <div class="table-responsive">
            <table class="table member-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Cihaz</th>
                        <th>Arıza</th>
                        <th>Durum</th>
                        <th>Yapılacak İşlemler</th>
                        <th>Tutar</th>
                        <th>Fiyat Onayı</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="member-muted">Henüz servis kaydın yok.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var fiyatKalemleri = item.ServisIslemler.Where(x => x.Islem != null).ToList();
                        <tr>
                            <td>@item.Tarih.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td>
                                <strong>@item.Cihaz?.Marka @item.Cihaz?.Model</strong>
                            </td>
                            <td class="member-table-description">@item.Cihaz?.ArizaAciklama</td>
                            <td><span class="member-pill @DurumSinif(item.Durum)">@DisplayTextHelper.Status(item.Durum)</span></td>
                            <td>
                                @if (fiyatKalemleri.Count == 0)
                                {
                                    <span class="member-muted">Servis ekibi inceleme sonrası işlemleri paylaşacak.</span>
                                }
                                else
                                {
                                    <div class="member-service-actions">
                                        @foreach (var servisIslem in fiyatKalemleri)
                                        {
                                            <div class="member-service-action">
                                                <div class="member-service-action-heading">
                                                    <strong>@servisIslem.Islem!.Ad</strong>
                                                    <span>@servisIslem.Islem.Fiyat.ToString("C0")</span>
                                                </div>
                                                @if (string.IsNullOrWhiteSpace(servisIslem.Islem.Aciklama) == false)
                                                {
                                                    <small>@servisIslem.Islem.Aciklama</small>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@item.ToplamFiyat.ToString("C0")</td>
                            <td>
                                @if (item.FiyatOnayDurumu == "Onay Bekliyor")
                                {
                                    <div class="member-offer-card">
                                        <strong class="member-offer-title">Fiyat kalemleri</strong>
                                        @if (fiyatKalemleri.Count == 0)
                                        {
                                            <span class="member-muted">Detay bekleniyor.</span>
                                        }
                                        else
                                        {
                                            <div class="member-price-breakdown">
                                                @foreach (var servisIslem in fiyatKalemleri)
                                                {
                                                    <div>
                                                        <span>@servisIslem.Islem!.Ad</span>
                                                        <strong>@servisIslem.Islem.Fiyat.ToString("C0")</strong>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <div class="member-offer-total">
                                            <span>Toplam</span>
                                            <strong>@item.ToplamFiyat.ToString("C0")</strong>
                                        </div>
                                        <div class="member-offer-actions">
                                            <form asp-action="FiyatKabul" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">Kabul Et</button>
                                            </form>
                                            <form asp-action="FiyatReddet" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-light btn-sm">Reddet</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="member-pill @DurumSinif(item.Durum)">@DisplayTextHelper.Status(item.FiyatOnayDurumu)</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
