@model ServisFormViewModel
@{
    ViewData["Title"] = "Servis Düzenle";
    ViewData["PageTitle"] = "Servis Kaydını Düzenle";
    ViewData["Subtitle"] = "Durumu, işlemleri ve cihaz bağlantısını güncelle.";
}

<div class="card">
    <div class="card-body p-4 p-lg-5">
    <span class="admin-chip">Servis Güncelle</span>
    <h3 class="mt-3">Servis Kaydını Düzenle</h3>
    <p class="text-secondary mb-4">Durum, tarih ve işlem bağlantılarını düzenleyerek kaydı güncel tut.</p>

    <form asp-action="Edit" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Servis.Id" />
        <div asp-validation-summary="ModelOnly" class="validation full"></div>

        <div class="field full">
            <label>Cihaz</label>
            <select asp-for="Servis.CihazId">
                @foreach (var c in Model.Cihazlar)
                {
                    if (c.Id == Model.Servis.CihazId)
                    {
                        <option value="@c.Id" selected>@c.Musteri?.AdSoyad - @c.Marka @c.Model</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Musteri?.AdSoyad - @c.Marka @c.Model</option>
                    }
                }
            </select>
        </div>

        <div class="field">
            <label>Tarih</label>
            <input asp-for="Servis.Tarih" type="date" class="input" />
        </div>

        <div class="field">
            <label>Durum</label>
            <select asp-for="Servis.Durum">
                @foreach (var d in new[] { "Bekliyor", "Islemde", "Fiyat Onayi Bekliyor", "Tamamlandi", "Teslim Edildi", "Fiyat Reddedildi" })
                {
                    if (Model.Servis.Durum == d)
                    {
                        <option value="@d" selected>@DisplayTextHelper.Status(d)</option>
                    }
                    else
                    {
                        <option value="@d">@DisplayTextHelper.Status(d)</option>
                    }
                }
            </select>
        </div>

        <div class="field">
            <label>Fiyat Onayı</label>
            <label class="checkbox-item">
                <span>Müşteri ekranına fiyat onayı düşür</span>
                <input asp-for="FiyatiOnayaGonder" />
            </label>
            <small class="text-secondary">İşaretlenirse seçili işlem tutarı müşteri panelinde kabul/reddet olarak görünür.</small>
        </div>

        <div class="field full">
            <partial name="_IslemSelector" model="Model" />
        </div>

        <div class="link-row full">
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Index" class="btn btn-light">Geri Dön</a>
        </div>
    </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
