@model List<Islem>
@{
    ViewData["Title"] = "İşlem Kataloğu";
    ViewData["PageTitle"] = "Servis İşlem Kataloğu";
    ViewData["Subtitle"] = "Bilgisayar, telefon ve ek hizmet fiyatlarını profesyonel katalog halinde yönet.";
}

<div class="card premium-card">
    <div class="card-body">
        @{
            var kategoriler = (ViewBag.Kategoriler as IEnumerable<string>)?.ToList() ?? new List<string>();
        }
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <form method="get" class="row g-2 align-items-center flex-grow-1" style="max-width: 760px;">
                <div class="col-md-5">
                    <input class="form-control" type="text" name="q" value="@ViewBag.Q" placeholder="İşlem adı ara..." />
                </div>

                <div class="col-md-4">
                    <select name="kategori" class="form-select">
                        <option value="">Tüm Kategoriler</option>
                        @foreach (var kategori in kategoriler)
                        {
                            if ((ViewBag.Kategori?.ToString() ?? string.Empty) == kategori)
                            {
                                <option value="@kategori" selected>@kategori</option>
                            }
                            else
                            {
                                <option value="@kategori">@kategori</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-auto">
                    <button class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>Ara
                    </button>
                </div>
            </form>

            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i>Yeni İşlem
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Kategori</th>
                        <th>İşlem Adı</th>
                        <th>Fiyat Aralığı</th>
                        <th>Ortalama</th>
                        <th>Açıklama</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-secondary">İşlem bulunamadı.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-dark">@item.Kategori</span>
                            </td>
                            <td class="fw-semibold">@item.Ad</td>
                            <td>
                                @item.MinimumFiyat.ToString("C0") - @item.MaksimumFiyat.ToString("C0")
                            </td>
                            <td>@item.Fiyat.ToString("C0")</td>
                            <td class="text-secondary">
                                @(string.IsNullOrWhiteSpace(item.Aciklama) ? "-" : item.Aciklama)
                            </td>
                            <td>
                                <div class="action-cluster catalog-action-cluster">
                                    <a class="btn action-btn action-btn-edit catalog-action-btn" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i><span>Düzenle</span>
                                    </a>

                                    <form asp-action="Delete" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn action-btn action-btn-delete catalog-action-btn" type="submit">
                                            <i class="bi bi-trash3"></i><span>Sil</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
