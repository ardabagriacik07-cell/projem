@model AdminYorumlarViewModel
@{
    ViewData["Title"] = "Yorumlar";
    ViewData["PageTitle"] = "Kullanıcı Yorumları";
    ViewData["Subtitle"] = "Üyelerden gelen düşünceleri, puanları ve yeni geri bildirimleri takip edin.";
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4"><div class="card kpi-card h-100"><div class="card-body"><small class="text-secondary">Toplam Yorum</small><h3 class="display-6 fw-bold mb-0">@Model.ToplamYorum</h3></div></div></div>
    <div class="col-12 col-md-4"><div class="card kpi-card h-100"><div class="card-body"><small class="text-secondary">Yeni Yorum</small><h3 class="display-6 fw-bold mb-0">@Model.YeniYorum</h3></div></div></div>
    <div class="col-12 col-md-4"><div class="card kpi-card h-100"><div class="card-body"><small class="text-secondary">Ortalama Puan</small><h3 class="display-6 fw-bold mb-0">@Model.OrtalamaPuan.ToString("0.0")/5</h3></div></div></div>
</div>

<div class="card premium-card">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <span class="admin-chip">Geri Bildirim Akışı</span>
                <h3 class="mt-2 mb-0">Üye Yorumları</h3>
            </div>
        </div>
        <div class="admin-review-list">
            @if (Model.Yorumlar.Count == 0)
            {
                <div class="empty-admin-state">Henüz yorum gelmedi.</div>
            }
            else
            {
                @foreach (var yorum in Model.Yorumlar)
                {
                    <article class="admin-review-card @(yorum.YoneticiGordu ? "" : "new")">
                        <div class="admin-review-main">
                            <div>
                                <span class="admin-chip">@(yorum.YoneticiGordu ? "Okundu" : "Yeni")</span>
                                <h4>@yorum.Baslik</h4>
                                <p>@yorum.Mesaj</p>
                            </div>
                            <div class="admin-review-meta">
                                <strong>@yorum.Puan/5</strong>
                                <small>@yorum.Musteri?.AdSoyad</small>
                                <time>@yorum.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @if (yorum.YoneticiGordu == false)
                            {
                                <form asp-action="YorumOkundu" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@yorum.Id" />
                                    <button class="btn btn-sm btn-primary" type="submit">Okundu Yap</button>
                                </form>
                            }
                            <form asp-action="YorumSil" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@yorum.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Sil</button>
                            </form>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</div>
